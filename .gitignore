# 依赖与构建产物
node_modules/
dist/
.vite/
*.local

# 日志
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# 编辑器 / 系统
.DS_Store
.idea/
.vscode/
*.swp

# 环境变量
.env
.env.*
!.env.example

# Android
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/keystore.properties
*.jks
*.keystore

# 打包好的 APK：主站由 Cloudflare Pages 直接从仓库构建，APK 必须入库，
# 否则自动构建出来的站点里 /app-release.apk 会 404（CI 每次构建后会自动刷新它）。
# 只保留发布用的 app-release.apk，其他临时 apk 依旧忽略。
web/public/*.apk
!web/public/app-release.apk
