# 复制成 android/keystore.properties 并填好内容，CI 就会用正式签名打包。
# 这个文件不要提交到 Git（已在 .gitignore 中）。
#
# 生成密钥库：
#   keytool -genkeypair -v -keystore nongzi-release.jks -alias nongzi \
#           -keyalg RSA -keysize 2048 -validity 10000
#
storeFile=nongzi-release.jks
storePassword=改成你的密钥库密码
keyAlias=nongzi
keyPassword=改成你的密钥密码
